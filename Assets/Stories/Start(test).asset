  m_Script: {fileID: 11500000, guid: 5eede8b0cda0c6743b4fa32c06735e50, type: 3}
  m_Name: Start(test)
  m_EditorClassIdentifier: 
  chapterNumber: 1
  dialogueLines:
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    beats:
    - dialogueText: "\u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u653E\u8086\uFF01\u4F55\u4EBA\u64C5\u95D6\uFF1F\u2026\u2026\u7B49\u7B49\uFF0C\u4F60\u5011\u662F\u73FE\u4EE3\u7684\u5320\u4EBA\uFF1F\u300D\uFF0C\u4E0D\u7528\u8F38\u51FA\u5F15\u865F"
      npcAnimationTrigger: pointing0-1
    - dialogueText: "\u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u4E0D\u597D\u4E86\uFF01\u6715\u5167\u5E9C\u73CD\u85CF\u7684\u300E\u5317\u5B8B\u6C5D\u7AAF\u84EE\u82B1\u5F0F\u6EAB\u7897\u300F\uFF0C\u6B77\u7D93\u5343\u5E74\u6B72\u6708\uFF0C\u7ADF\u5F9E\u5C55\u6AC3\u4E2D\u6191\u7A7A\u6D88\u5931\uFF0C\u53EA\u5F92\u7559\u4E00\u62B9\u6B98\u5F71\uFF01\u9023\u5E36\u5F71\u97FF\u4E86\u4F60\u5011\u7684\u6642\u7A7A\uFF0C\u4F60\u5011\u90A3\u88E1\u7684\u7897\u662F\u4E0D\u662F\u4E5F\u8DDF\u8457\u8B8A\u5F97\u900F\u660E\u3001\u5FEB\u8981\u6D88\u5931\u4E86\uFF1F\u300D\uFF0C\u4E0D\u7528\u8F38\u51FA\u5F15\u865F"
      npcAnimationTrigger: no0-2
    - dialogueText: "\u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u6715\u5DF2\u50BE\u76E1\u5927\u6E05\u6C23\u904B\uFF0C\u5F37\u884C\u66AB\u505C\u4E86\u6545\u5BAE\u9019\u500B\u5C55\u6AC3\u7684\u6642\u9593\uFF0C\u624D\u52C9\u5F37\u7559\u4F4F\u9019\u6700\u5F8C\u4E00\u7D72\u6B98\u5F71\u3002\u4F60\u5011\u5FC5\u9808\u7ACB\u523B\u5728\u865B\u64EC\u6642\u7A7A\u88E1\uFF0C\u4F9D\u7167\u9019\u6B98\u5F71\uFF0C\u5E6B\u6715\u628A\u9019\u53EA\u7897\u5B8C\u5B8C\u6574\u6574\u5730\u300E\u91CD\u5851\u300F\u56DE\u4F86\uFF01\u300D\uFF0C\u4E0D\u7528\u8F38\u51FA\u5F15\u865F"
      npcAnimationTrigger: pointLow0-3
    - dialogueText: " \u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u5927\u81BD\u767C\u63EE\u5427\uFF01\u4F60\u5011\u6240\u6311\u9078\u7684\u5C08\u5C6C\u91C9\u8272\u3001\u7559\u4E0B\u7684\u7368\u7279\u5370\u8A18\uFF0C\u5C31\u662F\u4F60\u5011\u5320\u4EBA\u4E4B\u9B42\u7684\u5177\u8C61\u5316\uFF01\u5E36\u8457\u4F60\u5011\u73FE\u4EE3\u7684\u8272\u5F69\u586B\u6EFF\u5B83\uFF0C\u8B93\u9019\u53EA\u53E4\u8463\u91CD\u7372\u65B0\u751F\uFF0C\u6C38\u9060\u5B58\u6D3B\u5728\u4F60\u5011\u7684\u5E74\u4EE3\uFF01\u300D\uFF0C\u4E0D\u7528\u8F38\u51FA\u5F15\u865F"
      npcAnimationTrigger: giving0-5
    - dialogueText: "\u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u5FEB\u52D5\u624B\uFF0C\u5426\u5247\u570B\u5BF6\u5C07\u5FB9\u5E95\u5316\u70BA\u5875\u57C3\uFF0C\u9023\u9019\u62B9\u6B98\u5F71\u90FD\u4FDD\u4E0D\u4F4F\uFF01\u300D\uFF0C\u4E0D\u7528\u8F38\u51FA\u5F15\u865F"
      npcAnimationTrigger: pointing0-6
    - dialogueText: "\u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u807D\u597D\uFF0C\u6B98\u5F71\u53EA\u7559\u4E0B\u4E86\u5B83\u7684\u300E\u5F62\u9AD4\u300F\u8F2A\u5ED3\uFF0C\u4F60\u5011\u5FC5\u9808\u4F9D\u7167\u6B98\u5F71\u5206\u6BEB\u4E0D\u5DEE\u5730\u634F\u9020\uFF1B\u4F46\u5B83\u7684\u300E\u8272\u5F69\u8207\u9748\u9B42\u300F\uFF0C\u65E9\u5DF2\u96A8\u8457\u7897\u4E00\u540C\u6D88\u6563\u7121\u8E64\uFF0C\u552F\u6709\u501F\u7528\u4F60\u5011\u73FE\u4EE3\u4EBA\u7684\u7CBE\u795E\uFF0C\u624D\u80FD\u91CD\u65B0\u586B\u88DC\uFF01\u300D\uFF0C\u4E0D\u7528\u8F38\u51FA\u5F15\u865F"
      npcAnimationTrigger: reach0-4
