  dialogueLines:
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u4F60\u8981\u548C\u5169\u4F4D\u73A9\u5BB6\u8AAA\u660E\u63A5\u4E0B\u4F86\u7684\u4EFB\u52D9\u5167\u5BB9\uFF0C\u7BC4\u4F8B\u53F0\u8A5E\uFF1A\u300C\u518D\u4F86\uFF0C\u4F60\u5011\u9700\u8981\u56DE\u7B54\u6211\u7684\u7B2C\u4E8C\u500B\u554F\u984C\uFF0C\u4F60\u5011\u9700\u8981\u7B54\u5C0D\u624D\u80FD\u7372\u5F97\u8ABF\u914D\u6C5D\u7AAF\u84EE\u82B1\u6EAB\u7897\u7684\u91C9\u6599\u6240\u9700\u7684\u539F\u6750\u6599\u548C\u984F\u6599\uFF0C\u4F60\u5011\u540C\u6A23\u53EF\u4EE5\u96A8\u6642\u554F\u6211\u4EFB\u4F55\u554F\u984C\u3002\u300D"
    npcAnimationTrigger: 
    startsFreeChat: 0
    freeChatSuccessKeyword: 
    requiresInteraction: 0
    objectsToShow:
    - FreeChat_Button
    objectsToHide: []
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u8ACB\u56FA\u5B9A\u8F38\u51FA\u9019\u500B\u53F0\u8A5E\uFF1A\u300C\u6C5D\u7AAF\u5929\u9752\uFF0C\u7D55\u5728\u300E\u7AAF\u8B8A\u300F\u3002\u82E5\u60F3\u5728\u51FA\u7AAF\u90A3\u4E00\u523B\uFF0C\u5448\u73FE\u6EAB\u9152\u7897\u8868\u9762\u5982\u96E8\u904E\u5929\u6674\u3001\u5E36\u9EDE\u5FAE\u85CD\u7684\u300E\u5929\u9752\u300F\uFF0C\u800C\u975E\u6D41\u65BC\u4FD7\u6C23\u7684\u7FE0\u7DA0\uFF0C\u4F60\u5011\u8A8D\u70BA\u5728\u71D2\u88FD\u7684\u904E\u7A0B\u4E2D\uFF0C\u7210\u706B\u61C9\u8A72\u5982\u4F55\u63A7\u5236\uFF1F\u300D\u6B63\u78BA\u7B54\u6848\uFF1A\u5728\u9054\u5230\u6700\u9AD8\u6EAB\uFF081200\xB0C\uFF09\u7684\u77AC\u9593\uFF0C\u8FC5\u901F\u6E1B\u5F31\u706B\u52E2(\u964D\u6EAB\u9084\u539F)\uFF0C\u5F37\u884C\u4E2D\u6B62\u9435\u5143\u7D20\u7684\u5316\u5B78\u53CD\u61C9\u3002"
    npcAnimationTrigger: 
    startsFreeChat: 1
    freeChatSuccessKeyword: "\u8AAA\u5F97\u4E0D\u932F\uFF01"
    requiresInteraction: 0
    objectsToShow: []
    objectsToHide: []
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u300C\uFF08\u8AAA\u4E00\u4E9B\u6709\u7684\u6C92\u7684\uFF09...\u63A5\u4E0B\u4F86\u4F60\u5011\u53EF\u4EE5\u958B\u59CB\u9032\u884C\u91C9\u6599\u7684\u8ABF\u914D\u4E86\uFF0C\u91C9\u6599\u539F\u672C\u7684\u4E3B\u539F\u6599\u662F\u9EC3\u91D1\u571F\u548C\u746A\u7459\uFF0C\u4F46\u662F\u4F60\u5011\u53EF\u4EE5\u76E1\u60C5\u767C\u63EE\u4F60\u5011\u7684\u5275\u610F\uFF0C\u52A0\u4E0A\u4F60\u5011\u60F3\u8981\u7684\u984F\u6599\uFF0C\u88FD\u4F5C\u51FA\u5C08\u5C6C\u65BC\u4F60\u5011\u73FE\u4EE3\u98A8\u683C\u7684\u84EE\u82B1\u6EAB\u7897\uFF01\u300D"
    npcAnimationTrigger: 
