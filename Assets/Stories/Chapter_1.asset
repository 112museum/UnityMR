  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    beats:
    - dialogueText: "\u8ACB\u56FA\u5B9A\u8F38\u51FA\u9019\u500B\u53F0\u8A5E\uFF1A\u300C\u6715\u7576\u5E74\u4E5F\u66FE\u5728\u9019\u7897\u5E95\u984C\u904E\u4E00\u9996\u8A69\uFF0C\u843D\u6B3E\u53EA\u7559\u4E86\u5E7E\u500B\u5B57\uFF0C\u6C92\u5BEB\u5E74\u865F\u2014\u2014\u4F60\u5011\u5012\u662F\u7B97\u7B97\uFF0C\u6715\u662F\u4F55\u6642\u984C\u4E0B\u9019\u9996\u8A69\u7684\uFF1F\u300D\u4E5F\u53EF\u4EE5\u9069\u7576\u52A0\u4E0A\u7687\u5E1D\u7684\u81EA\u7A31\uFF0C\u5F15\u865F\u4E0D\u7528\u8F38\u51FA\u3002"
      npcAnimationTrigger: talking1-1
    startsFreeChat: 1
    freeChatSuccessKeyword: "\u54C8\u54C8\uFF0C\u7B97\u5F97\u4E0D\u932F\uFF01"
    freeChatAnswerKey: "\u6B63\u78BA\u7B54\u6848\uFF1A \u843D\u6B3E\u5BEB\u8457\u300C\u6642\u5E74\u53E4\u7A00\uFF0C\u4EF2\u6625\u6708\u984C\u300D\u2014\u2014\u300C\u4EF2\u6625\u300D\u9EDE\u660E\u662F\u8FB2\u66C6\u4E8C\u6708\u9593\uFF1B\u642D\u914D\u300C\u53E4\u7A00\u300D\uFF1D70\u6B72\u3001\u7687\u5E1D\u751F\u65BC\u897F\u51431711\u5E74\uFF0C\u53EF\u63A8\u7B97\u51FA\u897F\u51431780\u5E74\u524D\u5F8C\uFF08\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\uFF09\u3002\u5B8C\u6574\u7B54\u6848\u662F\u300C\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u4EF2\u6625\u300D\uFF0C\u4E5F\u5C31\u662F\u897F\u51431780\u5E74\u6625\u5929\u3002\u73A9\u5BB6\u7B54\u51FA\u300C1780\u5E74\u300D\u6216\u300C\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u300D\u4E5F\u7B97\u5C0D\uFF08\xB11\u5E74\u8AA4\u5DEE\uFF09\uFF0C\u7B54\u51FA\u9023\u5B63\u7BC0\u90FD\u5C0D\u4E0A\u5247\u662F\u6700\u5B8C\u6574\u7684\u7B54\u6848\u3002\u897F\u51431780\u5E74\u70BA\u6A19\u6E96\u7B54\u6848\uFF0C\u5141\u8A31\u8AA4\u5DEE\xB11\u5E74\uFF0C\u4E5F\u5C31\u662F\u73A9\u5BB6\u7B541779\uFF5E1781\u4E4B\u9593\uFF08\u542B\u865B\u6B72/\u5468\u6B72\u5169\u7A2E\u7B97\u6CD5\uFF09\u90FD\u7B97\u7B54\u5C0D\uFF1B\u63DB\u7B97\u6210\u5E74\u865F\u5247\u662F\u300C\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u300D\u524D\u5F8C\uFF0C\u7B54\u9019\u500B\u4E5F\u7B97\u5C0D\u3002"
    freeChatHint: "\u601D\u8003\u7DDA\u7D22\uFF08\u53EF\u5206\u5C64\u63D0\u793A\uFF0C\u73A9\u5BB6\u7B54\u4E0D\u51FA\u4F86\u6642\u9010\u6B65\u91CB\u51FA\uFF09\uFF1A
      \u63D0\u793A1\uFF08\u6A21\u7CCA\uFF09\uFF1A\u300C\u843D\u6B3E\u88E1\u90A3\u5169\u500B\u5B57\uFF0C\u662F\u5F62\u5BB9\u6B72\u6578\u7684\u8AAA\u6CD5\uFF0C\u4E0D\u662F\u96A8\u4FBF\u5BEB\u5BEB\u7684\u3002\u300D\uFF0C\u63D0\u793A2\uFF08\u8F03\u660E\u78BA\uFF09\uFF1A\u300C\u9019\u5169\u500B\u5B57,\u662F\u5F9E\u4E00\u53E5\u53E4\u8A69\u88E1\u501F\u4F86\u7684\u2014\u2014\u4F60\u5011\u627E\u627E,\u7897\u4E0A\u9084\u6709\u6C92\u6709\u5225\u7684\u5B57\u8DDF\u9019\u53E5\u8A69\u6709\u95DC\u3002\u300D "
    requiresInteraction: 0
    taskTextPlayer1: "\u7DDA\u7D22\uFF1A\u9019\u4F4D\u7687\u5E1D\u751F\u65BC\u897F\u51431711\u5E74\uFF08\u8F9B\u536F\u5154\u5E74\uFF09\u3002\u4E0D\u77E5\u9053\u7897\u4E0A\u984C\u4E86\u4EC0\u9EBC\u5B57\uFF0C\u4E5F\u4E0D\u77E5\u9053\u8981\u7B97\u54EA\u4E00\u5E74\u3002"
    taskTextPlayer2: "\u7897\u5E95\u523B\u6709\u984C\u8A69\uFF0C\u843D\u6B3E\u5BEB\u8457\u300C\u6642\u5E74\u53E4\u7A00\uFF0C\u4EF2\u6625\u6708\u984C\u300D\uFF1B\u843D\u6B3E\u65C1\u9084\u6709\u4E00\u884C\u5C0F\u5B57\u6CE8\u89E3\uFF0C\u5F15\u7528\u4E86\u675C\u752B\u7684\u8A69\u53E5\u300C\u4EBA\u751F\u4E03\u5341\u53E4\u4F86\u7A00\u300D\uFF0C\u4F46\u6C92\u6709\u8AAA\u660E\u9019\u53E5\u8A69\u8DDF\u843D\u6B3E\u7684\u300C\u53E4\u7A00\u300D\u6709\u4EC0\u9EBC\u95DC\u4FC2\u3002"
    objectsToShow: []
    objectsToHide: []
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    beats:
    - dialogueText: "\u8ACB\u56FA\u5B9A\u8F38\u51FA\uFF1A\u300C\u6B63\u662F\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u4EF2\u6625\uFF0C\u6715\u984C\u9019\u8A69\u6642\u5DF2\u5C46\u53E4\u7A00\u4E4B\u5E74\u2014\u2014\u90A3\u5E74\u958B\u6625\uFF0C\u6715\u53C8\u60F3\u8D77\u4E86\u9019\u4EF6\u84EE\u82B1\u6EAB\u7897\uFF0C\u63D0\u7B46\u5BEB\u4E0B\u9019\u5E7E\u53E5\u3002\u4F60\u5011\u5169\u500B\uFF0C\u7E3D\u7B97\u6C92\u8F9C\u8CA0\u6715\u7684\u9019\u756A\u5FC3\u601D\uFF01\u300D\uFF0C\u4E0D\u8981\u65B0\u589E\u6216\u522A\u9664\u53E5\u5B50\u3002\u4E5F\u53EF\u4EE5\u9069\u7576\u52A0\u4E0A\u7687\u5E1D\u7684\u81EA\u7A31\uFF0C\u5F15\u865F\u4E0D\u7528\u8F38\u51FA\u3002"
      npcAnimationTrigger: yes1-2
