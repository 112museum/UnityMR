  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    beats:
    - dialogueText: "\u4ECB\u7D39\u4F60\u81EA\u5DF1"
      npcAnimationTrigger: 
    - dialogueText: " \u56FA\u5B9A\u8F38\u51FA\uFF1A \u300Cl\u4F60\u5011\u5FC5\u9808\u7ACB\u523B\u5728\u865B\u64EC\u6642\u7A7A\u88E1\uFF0C\u4F9D\u7167\u9019\u6B98\u5F71\uFF0C\u5E6B\u6715\u628A\u9019\u53EA\u7897\u5B8C\u5B8C\u6574\u6574\u5730\u300E\u91CD\u5851\u300F\u56DE\u4F86\uFF01
        \u300D"
      npcAnimationTrigger: 
    - dialogueText: " \u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u5927\u81BD\u767C\u63EE\u5427\uFF01
        \u300D"
      npcAnimationTrigger: 
    - dialogueText: " \u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u6715\u544A\u8A34\u4F60\u5011,\u63A5\u4E0B\u4F86\u7684\u4EFB\u52D9\u662F\u9019\u6A23\u7684\u3002\u9996\u5148,\u4F60\u5011\u9700\u8981\u56DE\u7B54\u6715\u7684\u7B2C\u4E00\u500B\u554F\u984C,\u7B54\u5C0D\u7684\u8A71,\u6715\u5C07\u8CDC\u4E88\u4F60\u5011\u6C5D\u7AAF\u84EE\u82B1\u6EAB\u7897\u7684\u7D20\u576F\u3002
        \u300D"
      npcAnimationTrigger: 
    - dialogueText: " \u56FA\u5B9A\u8F38\u51FA\uFF1A \u300C\u63A5\u4E0B\u4F86,\u6715\u8981\u4F60\u5011\u958B\u59CB\u9032\u884C\u91C9\u6599\u7684\u8ABF\u914D\u3002\u91C9\u6599\u7684\u4E3B\u8981\u539F\u6599\u662F\u9EC3\u91D1\u571F\u548C\u746A\u7459,\u4F46\u4F60\u5011\u53EF\u4EE5\u767C\u63EE\u5275\u610F\u3002
        \u300D"
      npcAnimationTrigger: 
