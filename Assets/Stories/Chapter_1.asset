  dialogueLines:
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u4F60\u8981\u548C\u5169\u4F4D\u73A9\u5BB6\u8AAA\u660E\u63A5\u4E0B\u4F86\u7684\u4EFB\u52D9\u5167\u5BB9\uFF0C\u7BC4\u4F8B\u53F0\u8A5E\uFF1A\u300C\u9996\u5148\uFF0C\u4F60\u5011\u9700\u8981\u56DE\u7B54\u6211\u7684\u7B2C\u4E00\u500B\u554F\u984C\uFF0C\u4F60\u5011\u9700\u8981\u7B54\u5C0D\u624D\u80FD\u7372\u5F97\u6C5D\u7AAF\u84EE\u82B1\u6EAB\u7897\u7684\u7D20\u576F\uFF0C\u4F60\u5011\u53EF\u4EE5\u96A8\u6642\u554F\u6211\u4EFB\u4F55\u554F\u984C\uFF0C\u7372\u5F97\u7B54\u6848\u7684\u7DDA\u7D22\u3002\u795D\u4F60\u5011\u597D\u904B\uFF01\u300D"
    npcAnimationTrigger: 
    startsFreeChat: 0
    freeChatSuccessKeyword: 
    requiresInteraction: 0
    objectsToShow:
    - FreeChat_Button
    objectsToHide: []
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u8ACB\u56FA\u5B9A\u8F38\u51FA\u9019\u500B\u53F0\u8A5E\uFF1A\u300C\u6715\u7576\u5E74\u4E5F\u66FE\u5728\u9019\u7897\u5E95\u984C\u904E\u4E00\u9996\u8A69\uFF0C\u843D\u6B3E\u53EA\u7559\u4E86\u5E7E\u500B\u5B57\uFF0C\u6C92\u5BEB\u5E74\u865F\u2014\u2014\u4F60\u5011\u5012\u662F\u7B97\u7B97\uFF0C\u6715\u662F\u4F55\u6642\u984C\u4E0B\u9019\u9996\u8A69\u7684\uFF1F\u300D\u3002\u6B63\u78BA\u7B54\u6848\uFF1A
      \u843D\u6B3E\u5BEB\u8457\u300C\u6642\u5E74\u53E4\u7A00\uFF0C\u4EF2\u6625\u6708\u984C\u300D\u2014\u2014\u300C\u4EF2\u6625\u300D\u9EDE\u660E\u662F\u8FB2\u66C6\u4E8C\u6708\u9593\uFF1B\u642D\u914D\u300C\u53E4\u7A00\u300D\uFF1D70\u6B72\u3001\u7687\u5E1D\u751F\u65BC\u897F\u51431711\u5E74\uFF0C\u53EF\u63A8\u7B97\u51FA\u897F\u51431780\u5E74\u524D\u5F8C\uFF08\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\uFF09\u3002\u5B8C\u6574\u7B54\u6848\u662F\u300C\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u4EF2\u6625\u300D\uFF0C\u4E5F\u5C31\u662F\u897F\u51431780\u5E74\u6625\u5929\u3002\u73A9\u5BB6\u7B54\u51FA\u300C1780\u5E74\u300D\u6216\u300C\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u300D\u4E5F\u7B97\u5C0D\uFF08\xB11\u5E74\u8AA4\u5DEE\uFF09\uFF0C\u7B54\u51FA\u9023\u5B63\u7BC0\u90FD\u5C0D\u4E0A\u5247\u662F\u6700\u5B8C\u6574\u7684\u7B54\u6848\u3002\u897F\u51431780\u5E74\u70BA\u6A19\u6E96\u7B54\u6848\uFF0C\u5141\u8A31\u8AA4\u5DEE\xB11\u5E74\uFF0C\u4E5F\u5C31\u662F\u73A9\u5BB6\u7B541779\uFF5E1781\u4E4B\u9593\uFF08\u542B\u865B\u6B72/\u5468\u6B72\u5169\u7A2E\u7B97\u6CD5\uFF09\u90FD\u7B97\u7B54\u5C0D\uFF1B\u63DB\u7B97\u6210\u5E74\u865F\u5247\u662F\u300C\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u300D\u524D\u5F8C\uFF0C\u7B54\u9019\u500B\u4E5F\u7B97\u5C0D\u3002"
    npcAnimationTrigger: 
    startsFreeChat: 1
    freeChatSuccessKeyword: "\u54C8\u54C8\uFF0C\u7B97\u5F97\u4E0D\u932F\uFF01"
    requiresInteraction: 0
    objectsToShow: []
    objectsToHide: []
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u8ACB\u56FA\u5B9A\u8F38\u51FA\uFF1A\u300C\u6B63\u662F\u4E7E\u9686\u56DB\u5341\u4E94\u5E74\u4EF2\u6625\uFF0C\u6715\u984C\u9019\u8A69\u6642\u5DF2\u5C46\u53E4\u7A00\u4E4B\u5E74\u2014\u2014\u90A3\u5E74\u958B\u6625\uFF0C\u6715\u53C8\u60F3\u8D77\u4E86\u9019\u4EF6\u84EE\u82B1\u6EAB\u7897\uFF0C\u63D0\u7B46\u5BEB\u4E0B\u9019\u5E7E\u53E5\u3002\u4F60\u5011\u5169\u500B\uFF0C\u7E3D\u7B97\u6C92\u8F9C\u8CA0\u6715\u7684\u9019\u756A\u5FC3\u601D\uFF01\u300D\uFF0C\u4E0D\u8981\u65B0\u589E\u6216\u522A\u9664\u53E5\u5B50\u3002"
