  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u8ACB\u56FA\u5B9A\u8F38\u51FA\u9019\u500B\u53F0\u8A5E\uFF1A\u300C\u6C5D\u7AAF\u5929\u9752\uFF0C\u7D55\u5728\u300E\u7AAF\u8B8A\u300F\u3002\u82E5\u60F3\u5728\u51FA\u7AAF\u90A3\u4E00\u523B\uFF0C\u5448\u73FE\u6EAB\u9152\u7897\u8868\u9762\u5982\u96E8\u904E\u5929\u6674\u3001\u5E36\u9EDE\u5FAE\u85CD\u7684\u300E\u5929\u9752\u300F\uFF0C\u800C\u975E\u6D41\u65BC\u4FD7\u6C23\u7684\u7FE0\u7DA0\uFF0C\u4F60\u5011\u8A8D\u70BA\u5728\u71D2\u88FD\u7684\u904E\u7A0B\u4E2D\uFF0C\u7210\u706B\u61C9\u8A72\u5982\u4F55\u63A7\u5236\uFF1F\u300D"
    npcAnimationTrigger: 
    startsFreeChat: 1
    freeChatSuccessKeyword: "\u8AAA\u5F97\u4E0D\u932F\uFF01"
    freeChatAnswerKey: "\u6B63\u78BA\u7B54\u6848\uFF1A\u5148\u662F\u7528\u4F4E\u6EAB\u6162\u6162\u5E36\u8D70\u6C34\u6C23\uFF0C\u518D\u7528\u5927\u706B\u4F7F\u6EAB\u5EA6\u7A69\u5B9A\u4E0A\u5347\u81F3\u6700\u9AD8\u6EAB\uFF081200\xB0C\uFF09\u3002\u5728\u9054\u5230\u6700\u9AD8\u6EAB\u7DAD\u6301\u4E00\u6BB5\u6642\u9593\u5F8C\uFF0C\u958B\u59CB\u9010\u6F38\u964D\u6EAB\u907F\u514D\u6EAB\u5EA6\u8B8A\u5316\u904E\u5FEB\u5C0E\u81F4\u7834\u88C2\u3002"
    freeChatHint: "\u601D\u8003\u7DDA\u7D22\uFF08\u53EF\u5206\u5C64\u63D0\u793A\uFF0C\u73A9\u5BB6\u7B54\u4E0D\u51FA\u4F86\u6642\u9010\u6B65\u91CB\u51FA\uFF09\uFF1A\u63D0\u793A1\uFF1A\u300C\u8AAA\u8D77\u4F86\uFF0C\u74F7\u5668\u88E1\u4F3C\u4E4E\u6709\u4E00\u500B\u6210\u5206\u6703\u56E0\u70BA\u9AD8\u6EAB\u800C\u8B8A\u8272\uFF0C\u5B8C\u5168\u770B\u4E0D\u51FA\u539F\u672C\u6A38\u7D20\u7684\u6A23\u5B50\u5462\uFF01\u300D\uFF0C\u63D0\u793A2\uFF1A\u300C\u5370\u8C61\u6DF1\u523B\u7684\u662F\uFF0C\u56E0\u70BA\u4E00\u6B21\u610F\u5916\u7AAF\u7210\u71D2\u4E86\u6574\u6574\u4E09\u5929\u4E09\u591C\uFF0C\u51FA\u4F86\u7684\u5931\u6557\u54C1\u53EA\u80FD\u7576\u5834\u6454\u74F7\u4E86\uFF0C\u6715\u8A18\u5F97\u90A3\u4E9B\u74F7\u5668\u7684\u6210\u8272\u90FD\u662F\u6B7B\u7DA0\u6216\u662F\u7126\u9EC3\u8272\u7684\u3002\u300D"
    requiresInteraction: 0
    taskTextPlayer1: "\u7DDA\u7D22\uFF1A\u91C9\u6599\u88E1\u542B\u9435\u5143\u7D20"
    taskTextPlayer2: "\u7DDA\u7D22\uFF1A\u51E1\u4E8B\u904E\u7336\u4E0D\u53CA"
    objectsToShow: []
    objectsToHide: []
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u7BC4\u4F8B\u8F38\u51FA\uFF1A\u300C\u9996\u5148\uFF0C\u5148\u7528\u5FAE\u706B\u628A\u576F\u9AD4\u88E1\u7684\u6FD5\u6C23\u6162\u6162\u70D8\u4E7E\uFF0C\u9019\u53EB\u4F4E\u6EAB\u6392\u6F6E\uFF1B\u7B49\u6C34\u6C23\u5168\u6563\u4E86\uFF0C\u518D\u9806\u8457\u7BC0\u594F\u7A69\u5B9A\u5347\u6EAB\uFF0C\u8B93\u6CE5\u571F\u5728\u88E1\u9762\u6162\u6162\u9069\u61C9\u71B1\u5EA6\u3002\u800C\u7576\u706B\u9054\u5230\u9802\u5CF0\u7684\u6642\u5019\uFF0C\u8981\u9802\u4F4F\u58D3\u529B\u9AD8\u6EAB\u6301\u6EAB\uFF0C\u7D66\u91C9\u85E5\u8DB3\u5920\u7684\u6642\u9593\u5FB9\u5E95\u878D\u5316\uFF1B\u6700\u5F8C\uFF0C\u518D\u63A7\u5236\u51B7\u537B\u7684\u964D\u6EAB\u901F\u5EA6\uFF0C\u907F\u514D\u6EAB\u5EA6\u8B8A\u5316\u904E\u5FEB\u5C0E\u81F4\u7834\u88C2\u3002\u56DB\u500B\u6B65\u9A5F\u53EF\u4E00\u6B65\u90FD\u932F\u4E0D\u5F97\uFF0C\u5F85\u6703\u91C9\u6599\u8ABF\u88FD\u5B8C\u6210\u4E4B\u5F8C\uFF0C\u5C31\u662F\u8003\u9A57\u4F60\u5011\u63A7\u5236\u706B\u4FAF\u7684\u6642\u5019\u4E86\u3002\u300D\u4E5F\u53EF\u4EE5\u9069\u7576\u52A0\u4E0A\u7687\u5E1D\u7684\u81EA\u7A31\uFF0C\u5F15\u865F\u4E0D\u7528\u8F38\u51FA\u3002"
