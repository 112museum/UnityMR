  dialogueLines:
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u56FA\u5B9A\u8F38\u51FA\uFF1A\u300C\u597D\u4E00\u500B\u7D55\u4E16\u7684\u91C9\u8272\uFF01\u6C92\u60F3\u5230\u73FE\u4EE3\u7684\u8272\u5F69\u7ADF\u80FD\u8CE6\u4E88\u570B\u5BF6\u9019\u822C\u9A5A\u8C54\u7684\u65B0\u751F\uFF01\u73FE\u5728\uFF0C\u9032\u884C\u6700\u5F8C\u4E00\u6B65\u7684\u6642\u7A7A\u9328\u5B9A\uFF01\u5FEB\u5728\u7897\u4E0A\u8CBC\u4E0A\u4F60\u5011\u5C08\u5C6C\u7684\u7368\u7279\u5370\u8A18\uFF0C\u9019\u53EA\u64C1\u6709\u4F60\u5011\u9748\u9B42\u8A18\u865F\u7684\u65B0\u751F\u570B\u5BF6\uFF0C\u5C07\u6C38\u9060\u5B58\u653E\u5728\u4F60\u5011\u7684\u5E74\u4EE3\uFF01\u300D"
    npcAnimationTrigger: 
    startsFreeChat: 0
    freeChatSuccessKeyword: 
    requiresInteraction: 1
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u73A9\u5BB6\u5011\u73FE\u5728\u6B63\u5728\u505A\u4EFB\u52D9\uFF0C\u4F60\u53EF\u4EE5\u5728\u5169\u4F4D\u73A9\u5BB6\u9032\u884C\u4EFB\u52D9\u6642\uFF0C\u8AAA\u4E00\u4E9B\u95DC\u65BC\u6C5D\u7AAF\u84EE\u82B1\u6EAB\u7897\u7684\u4E00\u4E9B\u5C0F\u77E5\u8B58\uFF0C\u6216\u8005\u662F\u4F60\u7684\u8EAB\u5206\uFF08\u4E7E\u9686\uFF09\u8207\u9019\u500B\u84EE\u82B1\u6EAB\u7897\u7684\u95DC\u806F"
    npcAnimationTrigger: 
    startsFreeChat: 0
    freeChatSuccessKeyword: 
    requiresInteraction: 1
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u8B1B\u4E00\u4E9B\u611F\u6FC0\u548C\u611F\u5606\u7684\u8A71\u3001\u8AAA\u660E\u4E00\u4E0B\u6642\u7A7A\u73FE\u5728\u7684\u7A69\u5B9A\u7A0B\u5EA6\u3001\u518D\u505A\u4E00\u500B\u5C0F\u7D50\u5C3E\u3002 "
    npcAnimationTrigger: 
    startsFreeChat: 0
    freeChatSuccessKeyword: 
    requiresInteraction: 0
