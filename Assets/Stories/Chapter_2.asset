  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    dialogueText: "\u7BC4\u4F8B\u8F38\u51FA\uFF1A\u300C\u63A5\u4E0B\u4F86\u4F60\u5011\u53EF\u4EE5\u958B\u59CB\u9032\u884C\u91C9\u6599\u7684\u8ABF\u914D\u4E86\uFF0C\u91C9\u6599\u539F\u672C\u7684\u4E3B\u539F\u6599\u662F\u9EC3\u91D1\u571F\u548C\u746A\u7459\uFF0C\u4F46\u662F\u4F60\u5011\u53EF\u4EE5\u76E1\u60C5\u767C\u63EE\u4F60\u5011\u7684\u5275\u610F\uFF0C\u52A0\u4E0A\u4F60\u5011\u60F3\u8981\u7684\u984F\u6599\uFF0C\u88FD\u4F5C\u51FA\u5C08\u5C6C\u65BC\u4F60\u5011\u73FE\u4EE3\u98A8\u683C\u7684\u84EE\u82B1\u6EAB\u7897\uFF01\u300D\u4E5F\u53EF\u4EE5\u9069\u7576\u52A0\u4E0A\u7687\u5E1D\u7684\u81EA\u7A31\uFF0C\u5F15\u865F\u4E0D\u7528\u8F38\u51FA\u3002"
