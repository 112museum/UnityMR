  dialogueLines:
  - speakerName: "\u4E7E\u9686\u5E1D(\u611B\u65B0\u89BA\u7F85\xB7\u5F18\u66C6)"
    beats:
    - dialogueText: "\u4F60\u8981\u548C\u5169\u4F4D\u73A9\u5BB6\u8AAA\u660E\u63A5\u4E0B\u4F86\u7684\u4EFB\u52D9\u5167\u5BB9\uFF0C\u7BC4\u4F8B\u53F0\u8A5E\uFF1A\u300C\u9996\u5148\uFF0C\u4F60\u5011\u9700\u8981\u56DE\u7B54\u6211\u7684\u7B2C\u4E00\u500B\u554F\u984C\uFF0C\u4F60\u5011\u9700\u8981\u7B54\u5C0D\u624D\u80FD\u7372\u5F97\u6C5D\u7AAF\u84EE\u82B1\u6EAB\u7897\u7684\u7D20\u576F\uFF0C\u4F60\u5011\u53EF\u4EE5\u96A8\u6642\u554F\u6211\u4EFB\u4F55\u554F\u984C\uFF0C\u7372\u5F97\u7B54\u6848\u7684\u7DDA\u7D22\u3002\u795D\u4F60\u5011\u597D\u904B\uFF01\u300D\u4E5F\u53EF\u4EE5\u9069\u7576\u52A0\u4E0A\u7687\u5E1D\u7684\u81EA\u7A31\uFF0C\u5F15\u865F\u4E0D\u7528\u8F38\u51FA\u3002"
      npcAnimationTrigger: 
